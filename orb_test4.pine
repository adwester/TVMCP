//@version=6
strategy("ORB Test4", overlay=true, pyramiding=0)

// orb_test3 + input.bool gate
// If 0 trades: input.bool or use_nyam check is broken
// If 29 trades: inputs fine, problem is elsewhere

use_nyam = input.bool(true, "NY AM (9:30 ET)")

TZ = "America/New_York"
tf = timeframe.period
orb_bars = math.max(1, int(30 / timeframe.multiplier))

in_nyam  = not na(time(tf, "0930-1600:23456", TZ))
nyam_new = in_nyam and not in_nyam[1]

var float nyam_h    = na
var float nyam_l    = na
var int   nyam_c    = 0
var bool  nyam_rdy  = false
var bool  nyam_done = false

if nyam_new
    nyam_h    := high
    nyam_l    := low
    nyam_c    := 1
    nyam_rdy  := false
    nyam_done := false
else if in_nyam and not nyam_rdy
    nyam_c += 1
    nyam_h  := math.max(nyam_h, high)
    nyam_l  := math.min(nyam_l, low)
    if nyam_c >= orb_bars
        nyam_rdy := true

if use_nyam and nyam_rdy and in_nyam and not nyam_done
    if high > nyam_h
        strategy.close_all()
        strategy.entry("NYAM_L", strategy.long)
        strategy.exit("NYAM_Lx", "NYAM_L", profit=100, loss=50)
        nyam_done := true
    else if low < nyam_l
        strategy.close_all()
        strategy.entry("NYAM_S", strategy.short)
        strategy.exit("NYAM_Sx", "NYAM_S", profit=100, loss=50)
        nyam_done := true

plot(nyam_rdy ? nyam_h : na, "H", color.blue, 1, plot.style_linebr)
plot(nyam_rdy ? nyam_l : na, "L", color.red,  1, plot.style_linebr)
