//@version=6
strategy("ORB Test6 - NYAM + LON", overlay=true, pyramiding=0)

use_nyam = input.bool(true, "NY AM (9:30 ET)")
use_lon  = input.bool(true, "London (3:00 ET)")
stop_x   = input.float(1.0, "Stop ×",   step=0.25)
tgt_x    = input.float(2.0, "Target ×", step=0.25)

TZ = "America/New_York"
tf = timeframe.period
orb_bars = math.max(1, int(30 / timeframe.multiplier))

in_nyam  = not na(time(tf, "0930-1600:23456", TZ))
in_lon   = not na(time(tf, "0300-1200:23456", TZ))
nyam_new = in_nyam and not in_nyam[1]
lon_new  = in_lon  and not in_lon[1]

var float nyam_h      = na
var float nyam_l      = na
var int   nyam_c      = 0
var bool  nyam_rdy    = false
var bool  nyam_traded = false

var float lon_h       = na
var float lon_l       = na
var int   lon_c       = 0
var bool  lon_rdy     = false
var bool  lon_traded  = false

if nyam_new
    nyam_h := high, nyam_l := low, nyam_c := 1, nyam_rdy := false, nyam_traded := false
else if in_nyam and not nyam_rdy
    nyam_c += 1
    nyam_h  := math.max(nyam_h, high)
    nyam_l  := math.min(nyam_l, low)
    if nyam_c >= orb_bars
        nyam_rdy := true

if lon_new
    lon_h := high, lon_l := low, lon_c := 1, lon_rdy := false, lon_traded := false
else if in_lon and not lon_rdy
    lon_c += 1
    lon_h  := math.max(lon_h, high)
    lon_l  := math.min(lon_l, low)
    if lon_c >= orb_bars
        lon_rdy := true

_ticks(rng, mult) => math.round(rng * mult / syminfo.mintick)

if use_nyam and nyam_rdy and in_nyam and not nyam_traded
    _r = nyam_h - nyam_l
    if high > nyam_h
        strategy.close_all()
        strategy.entry("NYAM_L", strategy.long)
        strategy.exit("NYAM_Lx", "NYAM_L", profit=_ticks(_r, tgt_x), loss=_ticks(_r, stop_x))
        nyam_traded := true
    else if low < nyam_l
        strategy.close_all()
        strategy.entry("NYAM_S", strategy.short)
        strategy.exit("NYAM_Sx", "NYAM_S", profit=_ticks(_r, tgt_x), loss=_ticks(_r, stop_x))
        nyam_traded := true

if use_lon and lon_rdy and in_lon and not lon_traded
    _r = lon_h - lon_l
    if high > lon_h
        strategy.close_all()
        strategy.entry("LON_L", strategy.long)
        strategy.exit("LON_Lx", "LON_L", profit=_ticks(_r, tgt_x), loss=_ticks(_r, stop_x))
        lon_traded := true
    else if low < lon_l
        strategy.close_all()
        strategy.entry("LON_S", strategy.short)
        strategy.exit("LON_Sx", "LON_S", profit=_ticks(_r, tgt_x), loss=_ticks(_r, stop_x))
        lon_traded := true

plot(use_nyam and nyam_rdy ? nyam_h : na, "NYAM H", color.blue,  1, plot.style_linebr)
plot(use_nyam and nyam_rdy ? nyam_l : na, "NYAM L", color.blue,  1, plot.style_linebr)
plot(use_lon  and lon_rdy  ? lon_h  : na, "LON H",  color.green, 1, plot.style_linebr)
plot(use_lon  and lon_rdy  ? lon_l  : na, "LON L",  color.green, 1, plot.style_linebr)
